modules = ["nodejs-24", "python-base-3.13"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "artifacts/my-app: web"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "artifacts/my-app"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/my-app run dev"
cwd = "./artifacts/my-app"
waitForPort = 8080
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "8080"
BASE_PATH = "/"

[[workflows.workflow]]
name = "Aethelia"
author = "agent"
mode = "sequential"

[workflows.workflow.metadata]
outputType = "webview"
artifactId = "3B4_FFSkEVBkAeYMFRJ2e"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server run dev"
cwd = "./artifacts/api-server"
waitForPort = 5000
ensurePreviewReachable = "/"
router = "path"

[workflows.workflow.tasks.env]
PORT = "5000"

# Составной запуск всего проекта: веб-приложение + api-сервер.
# Именно он назначен на кнопку Run (runButton выше), чтобы сервер
# поднимался сам после перезагрузки Repl — как раньше, без ручных
# остановок и перезапусков. Режим parallel: оба сервиса долгоживущие
# (dev-серверы не завершаются сами, sequential застрял бы на первом).
[[workflows.workflow]]
name = "Project"
author = "agent"
mode = "parallel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/my-app: web"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Aethelia"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000
